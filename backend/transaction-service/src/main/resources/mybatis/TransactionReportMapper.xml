<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.banksystem.transaction.infrastructure.mybatis.TransactionReportMapper">

  <!--
    Reporting read model over transfer_orders.
    Conventions:
      - fromTs inclusive, toTs exclusive (half-open range; service computes both from banking days).
      - "failed" groups terminal unsuccessful states: FAILED + COMPENSATED.
      - Money aggregates only count COMPLETED rows so in-flight/failed transfers never inflate volume.
      - Uses idx_transfer_created (created_at) for the range scan.
  -->

  <sql id="reportFilter">
    t.created_at &gt;= #{fromTs} AND t.created_at &lt; #{toTs}
    <if test="fromAccountId != null">
      AND t.from_account_id = #{fromAccountId}
    </if>
  </sql>

  <resultMap id="summaryRow"
             type="com.banksystem.transaction.api.dto.ReportDtos$ReportSummaryRow">
    <constructor>
      <arg column="total_count" javaType="_long"/>
      <arg column="completed_count" javaType="_long"/>
      <arg column="failed_count" javaType="_long"/>
      <arg column="completed_amount" javaType="java.math.BigDecimal"/>
      <arg column="fee_amount" javaType="java.math.BigDecimal"/>
      <arg column="avg_completed_amount" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <select id="summary" resultMap="summaryRow">
    SELECT COUNT(*)                                                              AS total_count,
           COUNT(*) FILTER (WHERE t.status = 'COMPLETED')                        AS completed_count,
           COUNT(*) FILTER (WHERE t.status IN ('FAILED', 'COMPENSATED'))         AS failed_count,
           COALESCE(SUM(t.amount)     FILTER (WHERE t.status = 'COMPLETED'), 0)  AS completed_amount,
           COALESCE(SUM(t.fee_amount) FILTER (WHERE t.status = 'COMPLETED'), 0)  AS fee_amount,
           COALESCE(ROUND(AVG(t.amount) FILTER (WHERE t.status = 'COMPLETED'), 2), 0)
                                                                                 AS avg_completed_amount
    FROM transfer_orders t
    WHERE <include refid="reportFilter"/>
  </select>

  <resultMap id="dailyVolumePoint"
             type="com.banksystem.transaction.api.dto.ReportDtos$DailyVolumePoint">
    <constructor>
      <arg column="day" javaType="java.time.LocalDate"/>
      <arg column="total_count" javaType="_long"/>
      <arg column="completed_count" javaType="_long"/>
      <arg column="failed_count" javaType="_long"/>
      <arg column="completed_amount" javaType="java.math.BigDecimal"/>
      <arg column="fee_amount" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <!-- Bucket by banking day in the report zone (created_at is TIMESTAMPTZ, i.e. UTC instant). -->
  <select id="dailyVolume" resultMap="dailyVolumePoint">
    SELECT (t.created_at AT TIME ZONE #{zone})::date                             AS day,
           COUNT(*)                                                              AS total_count,
           COUNT(*) FILTER (WHERE t.status = 'COMPLETED')                        AS completed_count,
           COUNT(*) FILTER (WHERE t.status IN ('FAILED', 'COMPENSATED'))         AS failed_count,
           COALESCE(SUM(t.amount)     FILTER (WHERE t.status = 'COMPLETED'), 0)  AS completed_amount,
           COALESCE(SUM(t.fee_amount) FILTER (WHERE t.status = 'COMPLETED'), 0)  AS fee_amount
    FROM transfer_orders t
    WHERE <include refid="reportFilter"/>
    GROUP BY 1
    ORDER BY 1
  </select>

  <resultMap id="statusBreakdownRow"
             type="com.banksystem.transaction.api.dto.ReportDtos$StatusBreakdownRow">
    <constructor>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="cnt" javaType="_long"/>
      <arg column="total_amount" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <select id="statusBreakdown" resultMap="statusBreakdownRow">
    SELECT t.status                     AS status,
           COUNT(*)                     AS cnt,
           COALESCE(SUM(t.amount), 0)   AS total_amount
    FROM transfer_orders t
    WHERE <include refid="reportFilter"/>
    GROUP BY t.status
    ORDER BY cnt DESC, t.status
  </select>

  <resultMap id="topAccountRow"
             type="com.banksystem.transaction.api.dto.ReportDtos$TopAccountRow">
    <constructor>
      <arg column="from_account_id" javaType="java.lang.String"/>
      <arg column="transfer_count" javaType="_long"/>
      <arg column="total_amount" javaType="java.math.BigDecimal"/>
    </constructor>
  </resultMap>

  <select id="topSourceAccounts" resultMap="topAccountRow">
    SELECT t.from_account_id::text  AS from_account_id,
           COUNT(*)                 AS transfer_count,
           SUM(t.amount)            AS total_amount
    FROM transfer_orders t
    WHERE t.status = 'COMPLETED'
      AND t.created_at &gt;= #{fromTs} AND t.created_at &lt; #{toTs}
    GROUP BY t.from_account_id
    ORDER BY total_amount DESC, transfer_count DESC
    LIMIT #{limit}
  </select>

  <resultMap id="exportReportRow"
             type="com.banksystem.transaction.api.dto.ReportDtos$ExportReportRow">
    <constructor>
      <arg column="id" javaType="java.lang.String"/>
      <arg column="created_at" javaType="java.lang.String"/>
      <arg column="from_account_id" javaType="java.lang.String"/>
      <arg column="to_account_number" javaType="java.lang.String"/>
      <arg column="amount" javaType="java.math.BigDecimal"/>
      <arg column="fee_amount" javaType="java.math.BigDecimal"/>
      <arg column="currency" javaType="java.lang.String"/>
      <arg column="status" javaType="java.lang.String"/>
      <arg column="description" javaType="java.lang.String"/>
    </constructor>
  </resultMap>

  <select id="streamExport" fetchSize="1000" resultMap="exportReportRow">
    SELECT t.id::text                        AS id,
           (t.created_at AT TIME ZONE 'UTC')::text AS created_at,
           t.from_account_id::text          AS from_account_id,
           t.to_account_number              AS to_account_number,
           t.amount                         AS amount,
           COALESCE(t.fee_amount, 0)        AS fee_amount,
           t.currency                       AS currency,
           t.status                         AS status,
           COALESCE(t.description, '')      AS description
    FROM transfer_orders t
    WHERE <include refid="reportFilter"/>
    ORDER BY t.created_at DESC
  </select>

</mapper>
