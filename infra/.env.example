# =============================================================================
# Bank System — environment template (SAFE TO COMMIT)
# =============================================================================
# Setup:
#   cp infra/.env.example infra/.env
#   # fill EVERY value in infra/.env for your machine/environment
#   # NEVER commit infra/.env
#
# Rules for this file:
#   - Only variable NAMES live here (values left empty).
#   - Comments describe purpose / how to generate — not real data.
#   - Put all real values only in infra/.env (gitignored).
#
# Run:
#   docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build
#
# Generate secrets (run locally; paste results into infra/.env only):
#   openssl rand -base64 48    # JWT_SECRET
#   openssl rand -base64 32    # AES_SECRET_KEY (must decode to 32 bytes)
#   openssl rand -hex 32       # PASSWORD_PEPPER, GATEWAY_SIGNING_SECRET, *_INTERNAL_API_KEY
#   openssl rand -base64 16 | tr -d '='   # KAFKA_CLUSTER_ID
# =============================================================================

# --- PostgreSQL ---
# DB role name used by services
POSTGRES_USER=
# Strong password for POSTGRES_USER
POSTGRES_PASSWORD=
# Hostname reachable from containers (Compose service name) or host
POSTGRES_HOST=
# Default DB name for the Postgres container bootstrap
POSTGRES_DEFAULT_DB=
# Port published on the host machine
POSTGRES_HOST_PORT=
# Port inside the Postgres container
POSTGRES_CONTAINER_PORT=
# Per-service database names
AUTH_DB_NAME=
CUSTOMER_DB_NAME=
ACCOUNT_DB_NAME=
TRANSACTION_DB_NAME=
NOTIFICATION_DB_NAME=

# Bind address for published host ports (loopback recommended for local dev)
HOST_BIND_ADDRESS=

# --- JWT (HS256) ---
# Long random string (>= 32 chars)
JWT_SECRET=
# Access / refresh / MFA token TTL in seconds
JWT_ACCESS_TTL=
JWT_REFRESH_TTL=
JWT_MFA_TTL=

# --- AES-256-GCM for PII / MFA secrets ---
# Base64 of exactly 32 raw bytes
AES_SECRET_KEY=

# --- Gateway → service request signing ---
# Shared HMAC secret (>= 32 random bytes as hex/base64 string)
GATEWAY_SIGNING_SECRET=
# Allowed clock skew for signed requests (seconds)
GATEWAY_MAX_CLOCK_SKEW_SECONDS=

# --- Per-service internal API keys (unique values; do not reuse) ---
AUTH_INTERNAL_API_KEY=
ACCOUNT_INTERNAL_API_KEY=
CUSTOMER_INTERNAL_API_KEY=
# Also injected into account so it can POST audit logs to transaction-service.
TRANSACTION_INTERNAL_API_KEY=
# Also injected into account/customer/transaction so they can POST OPS alerts.
NOTIFICATION_INTERNAL_API_KEY=

# --- Password hash pepper ---
# HMAC pepper before BCrypt; rotating invalidates all existing password hashes
PASSWORD_PEPPER=

# --- Bootstrap admin (seeded once if missing) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# true | false — set false after first staff account exists
ADMIN_SEED_ENABLED=

# --- Auth lockout ---
LOGIN_MAX_FAILURES=
LOGIN_LOCK_MINUTES=

# --- Account rules ---
ACCOUNT_MAX_PER_USER=
ACCOUNT_INITIAL_BALANCE=

# --- Service container ports (inside Docker network) ---
DISCOVERY_SERVICE_PORT=
AUTH_SERVICE_PORT=
CUSTOMER_SERVICE_PORT=
ACCOUNT_SERVICE_PORT=
TRANSACTION_SERVICE_PORT=
NOTIFICATION_SERVICE_PORT=
API_GATEWAY_HOST_PORT=
API_GATEWAY_SERVICE_PORT=
# Separate management/actuator port for api-gateway
API_GATEWAY_MANAGEMENT_PORT=

# --- Redis ---
REDIS_HOST=
REDIS_HOST_PORT=
REDIS_CONTAINER_PORT=
# transaction-service beneficiary address-book list cache TTL (seconds)
BENEFICIARY_CACHE_TTL_SECONDS=

# --- Kafka ---
KAFKA_HOST_PORT=
KAFKA_BROKER_PORT=
KAFKA_CONTROLLER_PORT=
KAFKA_NODE_ID=
# Required unique cluster id for KRaft; generate once per environment
KAFKA_CLUSTER_ID=
KAFKA_OFFSETS_REPLICATION_FACTOR=
KAFKA_TRANSACTION_REPLICATION_FACTOR=
KAFKA_TRANSACTION_MIN_ISR=
KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=
# true | false
KAFKA_AUTO_CREATE_TOPICS_ENABLE=
# Bootstrap servers string as seen by services
KAFKA_BOOTSTRAP=

# --- Observability host/container ports ---
ZIPKIN_HOST_PORT=
ZIPKIN_CONTAINER_PORT=
PROMETHEUS_HOST_PORT=
PROMETHEUS_CONTAINER_PORT=
GRAFANA_HOST_PORT=
GRAFANA_CONTAINER_PORT=

# --- Eureka / tracing ---
EUREKA_INSTANCE_HOSTNAME=
# Full Eureka defaultZone URL
EUREKA_URL=
# Full Zipkin spans endpoint URL
ZIPKIN_ENDPOINT=
# 0.0 – 1.0
TRACING_SAMPLE_PROBABILITY=
# true | false
EUREKA_SELF_PRESERVATION=
EUREKA_EVICTION_INTERVAL_MS=

# --- API Gateway ---
# Comma-separated origin list allowed by CORS
CORS_ORIGINS=
RATE_LIMIT_LOGIN=
RATE_LIMIT_LOGIN_WINDOW_SECONDS=
RATE_LIMIT_GLOBAL=
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=
# true | false
RATE_LIMIT_GLOBAL_ENABLED=

# --- Saga demo flag ---
# true | false
SAGA_FAIL_CREDIT=

# --- Transfer fee / internal GL seed (no real values in this file) ---
# Fee calculation (transaction-service)
TRANSFER_FEE_ENABLED=
TRANSFER_FEE_FLAT=
TRANSFER_FEE_PERCENT=
TRANSFER_FEE_MIN=
TRANSFER_FEE_MAX=
# Account number used by transaction-service to resolve fee income account
# Prefer same value as FEE_INCOME_ACCOUNT_NUMBER (account-service Flyway seed)
TRANSFER_FEE_INCOME_ACCOUNT=

# --- Email provider (notification-service) ---
# mock (default, logs MOCK_EMAIL) | smtp
EMAIL_PROVIDER=
# From address when using smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
# true | false
SMTP_AUTH=
# true | false
SMTP_STARTTLS=

# --- SMS provider (notification-service) ---
# mock (default, logs MOCK_SMS) | http
SMS_PROVIDER=
# Base URL of real/sandbox SMS gateway when SMS_PROVIDER=http (no trailing slash)
SMS_BASE_URL=
# Optional API key / bearer for http provider
SMS_API_KEY=
# Optional sender id / shortcode
SMS_FROM=

# --- NAPAS switch (transaction-service) ---
# mock (default) | http
NAPAS_PROVIDER=
# Base URL of real/sandbox NAPAS gateway when NAPAS_PROVIDER=http (no trailing slash)
NAPAS_BASE_URL=
# Optional API key / partner token for http provider
NAPAS_API_KEY=
# HMAC secret used to authenticate asynchronous payment callbacks (minimum 32 chars)
NAPAS_WEBHOOK_SECRET=
NAPAS_WEBHOOK_MAX_CLOCK_SKEW_SECONDS=
NAPAS_CONNECT_TIMEOUT_MS=
NAPAS_REQUEST_TIMEOUT_MS=
NAPAS_STATUS_POLL_MS=
NAPAS_STATUS_MIN_AGE_SECONDS=
NAPAS_STATUS_MAX_ATTEMPTS=
NAPAS_READ_RETRY_MAX_ATTEMPTS=
NAPAS_READ_RETRY_WAIT_DURATION=
NAPAS_CIRCUIT_BREAKER_WINDOW_SIZE=
NAPAS_CIRCUIT_BREAKER_MIN_CALLS=
NAPAS_CIRCUIT_BREAKER_FAILURE_RATE=
NAPAS_CIRCUIT_BREAKER_OPEN_DURATION=

# --- KYC object storage and antivirus ---
MINIO_CONTAINER_PORT=
MINIO_CONSOLE_CONTAINER_PORT=
MINIO_HOST_PORT=
MINIO_CONSOLE_HOST_PORT=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
KYC_STORAGE_ENDPOINT=
KYC_STORAGE_ACCESS_KEY=
KYC_STORAGE_SECRET_KEY=
KYC_STORAGE_BUCKET=
KYC_MAX_FILE_BYTES=
KYC_MULTIPART_MAX_FILE_SIZE=
KYC_MULTIPART_MAX_REQUEST_SIZE=
KYC_ANTIVIRUS_HOST=
KYC_ANTIVIRUS_PORT=
KYC_ANTIVIRUS_CONNECT_TIMEOUT_MS=
KYC_ANTIVIRUS_READ_TIMEOUT_MS=
CLAMAV_HOST_PORT=

# account-service Flyway placeholders for V2 fee-income seed (override per env)
# UUID of bank fee-income INTERNAL account
FEE_INCOME_ACCOUNT_ID=
# UUID of system/internal owner user for that account
SYSTEM_INTERNAL_USER_ID=
# Account number of bank fee-income INTERNAL account
FEE_INCOME_ACCOUNT_NUMBER=

# --- Transaction integration & resilience ---
KAFKA_PRODUCER_ACKS=
# true | false
KAFKA_PRODUCER_IDEMPOTENCE=
KAFKA_CONSUMER_GROUP=
# true | false
KAFKA_ENABLE_AUTO_COMMIT=
KAFKA_TOPIC_COMPLETED=
KAFKA_TOPIC_FAILED=
FEIGN_CONNECT_TIMEOUT_MS=
FEIGN_READ_TIMEOUT_MS=
CIRCUIT_BREAKER_WINDOW_SIZE=
CIRCUIT_BREAKER_FAILURE_RATE_THRESHOLD=
# Duration string, e.g. Spring duration format
CIRCUIT_BREAKER_OPEN_STATE_DURATION=
RETRY_MAX_ATTEMPTS=
RETRY_WAIT_DURATION=
OUTBOX_POLL_MS=
OUTBOX_BATCH_SIZE=

# --- Optional: end-of-day reconciliation (transaction-service) ---
# Defaults: disabled schedule, 00:30 banking-day zone. Manual runs via admin UI/API always work.
# RECON_ENABLED=true
# RECON_CRON=0 30 0 * * *

# --- Optional: term-deposit accrual/maturity batch (account-service) ---
# Defaults: disabled schedule, 00:15 banking-day zone. Manual runs via admin UI/API always work.
# DEPOSIT_BATCH_ENABLED=true
# DEPOSIT_BATCH_CRON=0 15 0 * * *

# --- Grafana ---
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# --- Feign Fallback URLs (local development overrides) ---
FEIGN_NOTIFICATION_URL=
FEIGN_CUSTOMER_URL=
FEIGN_ACCOUNT_URL=
FEIGN_TRANSACTION_URL=

