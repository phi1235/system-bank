# =============================================================================
# Bank System — environment template (SAFE TO COMMIT)
# =============================================================================
# On a new machine:
#   cp infra/.env.example infra/.env
#   # edit secrets in infra/.env  (NEVER commit .env)
#   docker compose -f infra/docker-compose.yml --env-file infra/.env up -d --build
#
# Required secrets (no defaults in YAML): must be set or stack fails to start.
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=bank
POSTGRES_PASSWORD=change-me-strong-db-password

# --- JWT (HS256, ≥ 32 characters) ---
JWT_SECRET=change-me-jwt-secret-at-least-32-chars-long!!
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
JWT_MFA_TTL=300

# --- AES-256 key for PII / MFA secrets (base64 of exactly 32 bytes) ---
# Generate: openssl rand -base64 32
AES_SECRET_KEY=change-me-replace-with-openssl-rand-base64-32=

# --- Internal service-to-service API key ---
INTERNAL_API_KEY=change-me-internal-api-key

# --- Password hash pepper (HMAC bind username+password before BCrypt) ---
# Generate: openssl rand -hex 32
# Rotating this invalidates all existing password hashes (re-seed / re-register).
PASSWORD_PEPPER=change-me-password-pepper-openssl-rand-hex-32

# --- Bootstrap admin (seeded once if missing) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-admin-password
ADMIN_EMAIL=admin@bank.local
ADMIN_SEED_ENABLED=true

# --- Auth lockout ---
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Account demo rules ---
ACCOUNT_MAX_PER_USER=3
ACCOUNT_INITIAL_BALANCE=1000000

# --- Network / infra (Docker Compose service names) ---
# When running services inside Compose, leave Docker defaults; local Maven uses host ports.
REDIS_HOST=redis
REDIS_PORT=6379
EUREKA_URL=http://discovery-server:8761/eureka/
KAFKA_BOOTSTRAP=kafka:9092
ZIPKIN_ENDPOINT=http://zipkin:9411/api/v2/spans
TRACING_SAMPLE_PROBABILITY=1.0

# --- API Gateway ---
CORS_ORIGINS=http://localhost:4200,http://localhost:5173
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_GLOBAL_ENABLED=true

# --- Saga demo ---
SAGA_FAIL_CREDIT=false

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# --- Optional: host-side DB when using init-databases.sh without Docker DNS ---
# DB_HOST=localhost
# DB_PORT=5433
